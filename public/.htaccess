# iHire Global static website + PHP enquiry endpoint (Apache 2.4).
# Merge with existing cPanel PHP handler directives; do not remove those.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Keep certificate validation and the existing mail host endpoint untouched.
RewriteRule ^\.well-known/ - [L]
RewriteCond %{HTTP_HOST} !^(www\.)?ihireglobal\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ - [L]

# Public Wix URLs inspected 7 November 2026.
RewriteRule ^find-talent/?$ https://www.ihireglobal.com/hire-talent/ [R=301,L]
RewriteRule ^about-1/?$ https://www.ihireglobal.com/about/ [R=301,L]
RewriteRule ^services-4/?$ https://www.ihireglobal.com/pricing/ [R=301,L]
RewriteRule ^general-4/?$ https://www.ihireglobal.com/hire-talent/#faqs [R=301,L,NE]
RewriteRule ^services-4-1/?$ https://www.ihireglobal.com/how-it-works/ [R=301,L]
RewriteRule ^(find-job|registerwithus)/?$ https://www.ihireglobal.com/jobs/ [R=301,L]
RewriteRule ^blog/?$ https://www.ihireglobal.com/resources/ [R=301,L]
RewriteRule ^airpropty/?$ https://www.ihireglobal.com/hire-talent/ [R=301,L]
RewriteRule ^contact-8/?$ https://www.ihireglobal.com/contact/ [R=301,L]
RewriteRule ^(sitemap|pages-sitemap)\.xml$ https://www.ihireglobal.com/sitemap-index.xml [R=301,L]

# Require a valid certificate for BOTH hosts before enabling the production site.
# 308 preserves method/body for the enquiry endpoint.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.ihireglobal\.com$ [NC]
RewriteRule ^ https://www.ihireglobal.com%{REQUEST_URI} [R=308,L]

# Empty/demo Wix pages have no genuine equivalent; return a proper 404.
# Unknown URLs also use the branded 404, never a blanket homepage redirect.
