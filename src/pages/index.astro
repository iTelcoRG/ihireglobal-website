---
import MobileDisclosure from '../components/MobileDisclosure.astro';
import ProcessJourney from '../components/ProcessJourney.astro';
import CustomerProof from '../components/CustomerProof.astro';
import Layout from '../layouts/Layout.astro';
import ComparisonSection from '../components/ComparisonSection.astro';
import CTASection from '../components/CTASection.astro';
import RoleCard from '../components/RoleCard.astro';
import LocationCard from '../components/LocationCard.astro';
import TeamGraphic from '../components/TeamGraphic.astro';
import DiscoveryList from '../components/DiscoveryList.astro';
import { roles } from '../data/roles';
import { locations } from '../data/site';
import { industries, needs } from '../data/discovery';
const featured=['administration','customer-service','digital-marketing','ecommerce','it-support','operations','monitoring-after-hours','accounting-finance'];
---
<Layout title="Offshore staffing for NZ & Australian businesses" description="Build your offshore team without the complexity. Dedicated staff, with recruitment, employment, payroll and local support managed by iHire Global.">
  <section class="home-hero"><div class="wrap hero-grid">
    <div class="hero-copy"><h1>Build your<br/>offshore team,<br/><span>without the<br/>offshore complexity.</span></h1><p class="lead">Dedicated offshore staff for New Zealand and Australian businesses. You manage their day-to-day work. We handle recruitment, employment, payroll, equipment and local support.</p><div class="button-row"><a class="button" href="/hire-talent/#enquiry">Find Talent <span aria-hidden="true">→</span></a><a class="text-link" href="/how-it-works/">How It Works <span aria-hidden="true">→</span></a></div><p class="hero-footnote">Established operations in Sri Lanka with access to talent across the wider Asia-Pacific region.</p></div>
    <TeamGraphic/>
  </div></section>
  <div class="trust-strip"><div class="wrap"><span>Built for <strong>NZ & Australian businesses</strong></span><span>Dedicated offshore staff</span><span>Recruitment handled</span><span>Employment managed</span><span>Equipment & local support</span></div></div>
  <section class="section wrap process-section"><div class="section-heading split-heading"><h2>From “we need someone”<br/>to “welcome to the team”.</h2><p>A straightforward process. A decision that stays with you. We take care of the steps around your next hire.</p></div><ProcessJourney/><a class="text-link" href="/how-it-works/">Explore the full process <span aria-hidden="true">→</span></a></section>
  <ComparisonSection/>
  <section class="section wrap"><div class="section-heading split-heading"><h2>Find talent<br/>by role.</h2><div><p>The skills you need. A person who gets to know your business.</p><a class="text-link" href="/roles/">View all roles </a></div></div><MobileDisclosure label="Browse roles"><div class="role-grid">{featured.map(slug=><RoleCard role={roles.find(role=>role.slug===slug)!}/>)}</div></MobileDisclosure></section>
  <section class="section needs-section"><div class="wrap needs-layout"><div><h2>What’s holding your business <em>back?</em></h2><p>Start with the problem.<br/>We’ll help you shape the role.</p><a class="text-link" href="/business-needs/">Explore business needs <span aria-hidden="true">→</span></a></div><DiscoveryList items={needs} base="business-needs"/></div></section>
  <section class="section wrap"><div class="section-heading split-heading"><h2>Where offshore talent<br/>can make an impact.</h2><div><p>Explore practical support for different operating models, with each role scoped to your business.</p><a class="text-link" href="/industries/">Explore industries </a></div></div><MobileDisclosure label="Browse industries"><DiscoveryList items={industries} base="industries"/></MobileDisclosure><p class="fine-print">Every industry has different requirements. We assess the skills, experience and support needed for your role, then recruit to match your business.</p></section>
  <section class="sri-section"><div class="wrap sri-grid"><div class="sri-visual"><div class="island-art" aria-hidden="true"><svg viewBox="0 0 220 300"><path d="M85 16 C91 39 112 55 129 81 C142 102 158 121 171 157 C190 203 174 248 142 267 C118 282 83 281 64 256 C44 231 46 191 54 163 C65 121 67 98 69 67 C70 43 76 23 85 16Z" fill="currentColor"/><path d="M85 16L142 267M69 67L171 157L64 256M54 163L129 81L142 267M54 163L174 211" stroke="#20282b" opacity=".3" fill="none"/><circle cx="72" cy="221" r="6" fill="#20282b"/><circle cx="72" cy="221" r="14" stroke="#20282b" fill="none"/></svg></div><div class="sri-visual-label"><strong>Sri Lanka</strong><span>Our established operation.</span></div></div><div class="sri-copy"><h2>Local experience.<br/>A stronger foundation<br/>for your team.</h2><p>Sri Lanka is where we’ve built our own offshore team. It’s where our practical understanding of recruitment, employment and local support starts.</p><p>Access administrative, digital, professional and technical skills, with English-language capability assessed for your role and working hours agreed around your business.</p><a class="text-link" href="/talent-locations/sri-lanka/">Explore our Sri Lanka operation </a></div></div></section>
  <section class="section wrap experience-grid"><h2>We use the offshore <br/>staffing model <br/>ourselves.</h2><div><p class="large-copy">We don’t just recruit offshore staff for other businesses. We operate offshore teams ourselves.</p><p>Our own operations include offshore Operations Manager, Digital Marketing Manager and Digital Platforms Manager roles. We understand the practical details of integrating people into a business, alongside the employment and infrastructure that support them.</p><div class="experience-list">{['Operations management','Digital marketing','Digital platforms','E-commerce administration','After-hours surveillance monitoring','Telephone sales verification'].map(item=><span>{item}</span>)}</div><a class="text-link" href="/use-cases/">Explore real use cases <span aria-hidden="true">→</span></a></div></section>
  <section class="section locations-section"><div class="wrap"><div class="section-heading split-heading"><h2>Rooted in Sri Lanka.<br/>Connected across Asia-Pacific.</h2><p>Established operations in Sri Lanka, with broader talent networks. Other locations depend on the role and your requirements.</p></div><div class="location-grid">{locations.map(location=><LocationCard location={location}/>)}</div></div></section>
  <section class="section wrap learn-home"><div class="section-heading split-heading"><h2>Understand the model.<br/>Plan your next move.</h2><a class="text-link" href="/resources/">Explore Learn </a></div><div class="learn-links"><a href="/resources/#staffing-guide"><h3>What is offshore staffing?</h3><p>Start with the fundamentals.</p></a><a href="/resources/#staffing-vs-outsourcing"><h3>Offshore staffing vs outsourcing</h3><p>Understand who manages the work.</p></a><a href="/business-needs/build-an-offshore-team/"><h3>How to build an offshore team</h3><p>Plan roles, onboarding and everyday management.</p></a></div></section>
  <CustomerProof/>
  <CTASection/>
</Layout>
