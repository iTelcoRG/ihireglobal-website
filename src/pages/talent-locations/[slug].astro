---
import Layout from '../../layouts/Layout.astro';import PageHero from '../../components/PageHero.astro';import CTASection from '../../components/CTASection.astro';import {locations} from '../../data/site';
export function getStaticPaths(){return locations.map(location=>({params:{slug:location.slug},props:{location}}));}const {location:l}=Astro.props;
---
<Layout title={`Hire offshore staff in ${l.name}`} description={`Explore offshore staffing in ${l.name} with iHire Global. ${l.status}. Discuss role requirements, recruitment and practical support.`} crumbs={[{name:'Talent Locations',url:'/talent-locations/'},{name:l.name,url:`/talent-locations/${l.slug}/`}]}><PageHero title={`Your team. Talent from ${l.name}.`} intro={l.intro}/><section class="section wrap compact-top detail-grid"><div><h2>{l.heading}</h2><p>{l.body}</p><ul class="check-list">{l.points.map(point=><li>{point}</li>)}</ul></div><aside class="surface-panel"><h2>What to expect.</h2><p>{l.detail}</p><a class="text-link" href="/how-it-works/">How recruitment works →</a></aside></section>{l.slug==='sri-lanka'&&<section class="section wrap compact-top prose"><h2>From recruitment to a working team.</h2><p>We advertise through local recruitment channels, review applicants and conduct initial screening. You receive candidate profiles, choose who to interview and make the selection. We then handle the offer, employment arrangements and agreed equipment.</p><p>Once your employee joins, you manage their work, training and performance. We continue supporting payroll, leave, pay changes and employment administration locally.</p><h2>Practical infrastructure matters.</h2><p>A laptop, suitable monitor and headset are only part of the setup. We also discuss connectivity, power backup where required, systems access and handover routines. Equipment and infrastructure costs are agreed with you.</p><a class="text-link" href="/roles/">Explore the roles you can hire →</a></section>}<CTASection/></Layout>
