---
import Layout from '../../layouts/Layout.astro';import PageHero from '../../components/PageHero.astro';import LocationCard from '../../components/LocationCard.astro';import CTASection from '../../components/CTASection.astro';import {locations} from '../../data/site';
---
<Layout title="Offshore talent locations across Asia-Pacific" description="Established staffing operations in Sri Lanka, with role-dependent sourcing networks in the Philippines, India and Fiji." crumbs={[{name:'Talent Locations',url:'/talent-locations/'}]}><PageHero title="The right location starts with the right role." intro="Our primary offshore operations are based in Sri Lanka. We can also source talent from the Philippines, India and Fiji depending on the role and requirements."/><section class="section wrap compact-top"><h2>Our talent locations.</h2><div class="location-grid">{locations.map(location=><LocationCard location={location}/>)}</div><div class="prose section"><h2>Agree the practical details first.</h2><p>We consider skills, communication, working hours, employment arrangements and infrastructure before recommending a sourcing approach. Availability and local support are confirmed for the specific role.</p></div></section><CTASection/></Layout>
