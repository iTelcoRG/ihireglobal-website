---
import PricingContent from '../components/PricingContent.astro';import ContactDetails from '../components/ContactDetails.astro';import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import CTASection from '../components/CTASection.astro';import ComparisonSection from '../components/ComparisonSection.astro';import ContactForm from '../components/ContactForm.astro';import FAQ from '../components/FAQ.astro';import RoleCard from '../components/RoleCard.astro';import LocationCard from '../components/LocationCard.astro';import LearnHub from '../components/LearnHub.astro';import {roles} from '../data/roles';import {steps,locations} from '../data/site';
const pages={
 'hire-talent':{name:'Hire Talent',title:'Hire dedicated offshore talent',heading:'Your next great hire starts here.',intro:'Add skills and capacity without building an offshore operation yourself. We recruit and support a dedicated employee who works directly with your business.',description:'Hire dedicated offshore staff for your NZ or Australian business. Explore our process, roles and support, then prepare your staffing requirements.'},
 'how-it-works':{name:'How It Works',title:'How managed offshore staffing works',heading:'You choose the person. We handle the process.',intro:'From understanding your requirements to supporting an employee in their role, here is how we help you build your offshore team.',description:'Follow the iHire Global recruitment journey: scope, recruit, screen, shortlist, interview, select, employ, equip, integrate and support.'},
 'why-ihire':{name:'Why iHire',title:'Why choose iHire for offshore staffing',heading:'Build your team. Keep things simple.',intro:'Offshore hiring brings practical questions. Who recruits? Who runs payroll? Who arranges the equipment? We bring those moving parts together so you can focus on leading your team.',description:'Discover how iHire handles offshore recruitment, payroll, employment administration and equipment while you manage your dedicated employee.'},
 pricing:{name:'Pricing',title:'Offshore staffing pricing and indicative quotes',heading:'Pricing built around the role you need.',intro:'Dedicated offshore staffing for New Zealand and Australian businesses, quoted around your requirements. We scope the role, recruit and validate the candidate market, then provide an indicative quote for you to review.',description:'Understand offshore staffing costs for NZ and Australian businesses. Scope the role, candidate market, employment and infrastructure before reviewing a quote.'},
 about:{name:'About',title:'About iHire Global',heading:'We know the work behind a working team.',intro:'iHire Global grew from real experience building and managing offshore teams. We use offshore teams ourselves, so the details matter to us as much as they do to you.',description:'Learn about iHire Global’s practical experience operating offshore teams in Sri Lanka and supporting New Zealand and Australian businesses.'},
 contact:{name:'Contact',title:'Contact iHire Global about your staffing needs',heading:'What could your team do with more capacity?',intro:'Whether you have a specific role in mind or are exploring offshore staffing for the first time, start by describing the work and the skills you need.',description:'Prepare a staffing brief for iHire Global. Describe your business, role, skills, preferred hours and hiring timeframe.'},
 jobs:{name:'Find a Job',title:'Dedicated remote roles with iHire Global',heading:'Your skills. An overseas team.',intro:'iHire recruits people for dedicated remote roles working closely with overseas businesses. Become part of a team, learn its systems and contribute to its day-to-day work.',description:'Learn about dedicated remote roles with overseas businesses through iHire Global. Job listing and candidate application information.'},
 resources:{name:'Learn',title:'Learn about offshore staffing',heading:'A practical guide to working across borders.',intro:'Understand the staffing model, explore talent locations and plan the practical details of building an offshore team. Start with the essentials, then go deeper as your requirements take shape.',description:'Learn how offshore staffing works, compare staffing with outsourcing, and explore hiring locations, costs, onboarding and team management.'}
};
export function getStaticPaths(){return ['hire-talent','how-it-works','why-ihire','pricing','about','contact','jobs','resources'].map(page=>({params:{page}}));}
const page=Astro.params.page as keyof typeof pages;const p=pages[page];
const benefits=[['Recruitment handled','We advertise, review applicants and conduct initial screening. You receive candidate profiles and decide who to interview.'],['Employment administration','We handle offers, contracts, payroll, leave administration and agreed employment changes. You retain control of daily work.'],['Practical equipment support','We coordinate laptops, monitors, headsets, connectivity and power backup where required, with costs scoped in your proposal.'],['Dedicated people','Your employee works in your business, follows your priorities and builds familiarity with your systems and customers.'],['A simpler offshore setup','Our managed model helps you engage offshore talent without establishing your own overseas operating entity for the role. Arrangements are confirmed for your requirements.'],['Ongoing local support','Our established Sri Lanka operation supports the practical details around your employee. Other locations are assessed case by case.']];
---
<Layout title={p.title} description={p.description} crumbs={[{name:p.name,url:`/${page}/`}]}><PageHero title={p.heading} intro={p.intro}>{page==='hire-talent'&&<a class="button" href="#enquiry">Find Talent ↗</a>}</PageHero>
{page==='hire-talent'&&<><section class="section wrap compact-top"><div class="feature-grid">{benefits.slice(0,3).map(([title,body])=><article><h2>{title}</h2><p>{body}</p></article>)}</div></section><section class="section wrap compact-top prose"><h2>From your brief to your shortlist.</h2><p>Tell us the role, hours, skills and experience you need. We advertise through local channels, review applicants and screen candidates. You receive profiles, choose who to interview and select the person. We validate candidate expectations and the setup requirements, then provide an indicative quote for your review. You agree the terms before we issue an offer and arrange employment and equipment.</p><a class="text-link" href="/how-it-works/">See every step →</a></section><ComparisonSection/><section class="section wrap"><h2>Where do you need support?</h2><div class="role-grid">{roles.slice(0,4).map((role,index)=><RoleCard role={role} index={index}/>)}</div><a class="text-link" href="/roles/">Explore all roles →</a></section><section class="section wrap compact-top"><h2>Established locally. Connected more widely.</h2><div class="location-grid">{locations.map(location=><LocationCard location={location}/>)}</div></section><FAQ/><ContactForm/></>}
{page==='how-it-works'&&<><section class="section wrap compact-top prose"><h2>Review the quote before you commit.</h2><p>Once we understand your brief, we recruit and validate the candidate market and establish the employment and infrastructure requirements. You receive an indicative quote to review before proceeding. Your preferred candidate is your decision; an offer follows your selection and agreement on the terms.</p><a class="text-link" href="/pricing/">How Pricing Works →</a></section><section class="section wrap compact-top"><ol class="long-process">{steps.map(([name,body])=><li id={name.toLowerCase()}><h2>{name}</h2><p>{body}</p></li>)}</ol></section><ComparisonSection/><CTASection/></>}
{page==='why-ihire'&&<><section class="section wrap compact-top prose"><h2>Support beyond the introduction.</h2><p>Recruitment is the start. We also handle employment administration, payroll, equipment provisioning, connectivity and agreed local operational support. Ongoing leave, pay and other employment changes are part of that support.</p><p>You manage daily tasks, work priorities, training, business processes, performance expectations and the employee's integration into your team. We do not take over day-to-day management.</p></section><section class="section wrap compact-top"><div class="feature-grid">{benefits.map(([title,body])=><article><h2>{title}</h2><p>{body}</p></article>)}</div></section><section class="section wrap compact-top prose"><h2>A clear commercial relationship.</h2><p>Work with iHire Global through a New Zealand-based commercial relationship and a point of contact for your staffing arrangements. Australian customer support arrangements can be discussed where applicable.</p><p>We agree responsibilities and scope before the hire. Employment requirements, equipment costs and the support available in a sourcing location are confirmed for the role.</p><h2>We use the model ourselves.</h2><p>Our own operations include offshore Operations Manager, Digital Marketing Manager and Digital Platforms Manager roles. Our wider operational experience includes Shopify administration, after-hours surveillance monitoring and telephone sales verification.</p><a class="text-link" href="/use-cases/">Explore real use cases →</a></section><ComparisonSection/><CTASection/></>}
{page==='pricing'&&<PricingContent/>}
{page==='about'&&<><section class="section wrap compact-top detail-grid"><div><h2>Experience beyond the shortlist.</h2><p>We understand that finding a good candidate is only the beginning. They need a clear role, working equipment, dependable connectivity and someone who can support the employment details locally.</p><p>Our own offshore experience includes operations management, digital marketing, digital platforms, e-commerce product administration, after-hours monitoring and telephone verification.</p><h2>A person in your business.</h2><p>We help you integrate a dedicated employee into your team. They work directly with you, using your systems and following your direction. You handle their priorities, training and performance; we handle the infrastructure around employing them.</p></div><aside class="surface-panel"><h2>Grounded in Sri Lanka.</h2><p>Our primary established staffing operation is in Sri Lanka. We serve businesses in New Zealand and Australia, with broader sourcing options in the Philippines, India and Fiji depending on the role.</p><a class="text-link" href="/talent-locations/sri-lanka/">Explore our Sri Lanka operation →</a></aside></section><CTASection/></>}
{page==='contact'&&<><section class="wrap compact-top"><ContactDetails/><p class="fine-print">Looking for work? Visit the <a href="/jobs/">candidate area</a> for job listing information.</p></section><ContactForm/></>}
{page==='jobs'&&<><section class="section wrap compact-top detail-grid"><div><h2>Work closely with an overseas business.</h2><p>Roles may include administration, customer support, marketing, technology, operations and other professional areas. Each position has its own experience, skills and working-hour requirements.</p><p>The customer manages your day-to-day work, priorities and training. iHire handles the agreed employment arrangements and ongoing employment administration.</p><h2>Apply to a role that fits.</h2><p>When vacancies are advertised, review the role requirements and follow the application instructions in the listing. Suitable candidates may be screened by iHire before interviewing with the customer.</p></div><aside class="placeholder-panel"><h2>Vacancy listings are coming.</h2><p>No live job feed is connected to this website yet. This is not a statement that there are no vacancies. Advertised roles and verified application links will appear here once available.</p><p>Applications are not accepted through the employer enquiry form.</p></aside></section></>}
{page==='resources'&&<><LearnHub/><CTASection/></>}
</Layout>
