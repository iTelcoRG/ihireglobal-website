---
import RoleConnections from '../../components/RoleConnections.astro';import Layout from '../../layouts/Layout.astro';import PageHero from '../../components/PageHero.astro';import CTASection from '../../components/CTASection.astro';import {roles} from '../../data/roles';
export function getStaticPaths(){return roles.map(role=>({params:{slug:role.slug},props:{role}}));}const {role}=Astro.props;
---
<Layout title={`Hire offshore ${role.title.toLowerCase()} staff`} description={`${role.short} Explore responsibilities, skills and recruitment for dedicated offshore ${role.title.toLowerCase()} staff with iHire Global.`} crumbs={[{name:'Roles',url:'/roles/'},{name:role.title,url:`/roles/${role.slug}/`}]}><PageHero title={role.short} intro={role.intro}><a class="button" href="/hire-talent/#enquiry">Find Talent <span aria-hidden="true">↗</span></a></PageHero><section class="wrap section compact-top detail-grid"><div><h2>What the role can cover.</h2><ul class="check-list">{role.tasks.map(task=><li>{task}</li>)}</ul><h2>Where it fits.</h2><p>{role.use}</p></div><div class="surface-panel"><h2>What to look for.</h2><p>{role.skills}</p><h2>How we recruit.</h2><p>{role.screening}</p></div></section><section class="wrap section compact-top prose"><h2>A team member, working your way.</h2><p>You set daily priorities, training and performance expectations. We handle recruitment, contracts, payroll and ongoing employment administration, with equipment and connectivity scoped to the role.</p><p>Our established primary operation is in <a href="/talent-locations/sri-lanka/">Sri Lanka</a>. Other sourcing markets depend on your requirements. <a href="/pricing/">Staffing costs</a> are scoped individually.</p><a class="text-link" href="/how-it-works/">See the recruitment process →</a></section><RoleConnections slug={role.slug}/><CTASection/></Layout>
