---
import DiscoveryLayout from '../../layouts/DiscoveryLayout.astro';
import { industries } from '../../data/discovery';
export function getStaticPaths() { return industries.map(entry => ({ params: { slug: entry.slug }, props: { entry } })); }
const { entry } = Astro.props;
---
<DiscoveryLayout entry={entry} kind="industries"/>
