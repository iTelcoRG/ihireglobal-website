---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import DiscoveryList from '../../components/DiscoveryList.astro';
import CTASection from '../../components/CTASection.astro';
import { industries } from '../../data/discovery';
---
<Layout title="Offshore staffing by industry" description="Explore offshore staffing use cases for healthcare, e-commerce, telecommunications, professional services, technology and security monitoring." crumbs={[{name:'Industries',url:'/industries/'}]}>
  <PageHero title="Where offshore talent can make an impact." intro="Different businesses need different kinds of support. Explore where a dedicated offshore employee could fit into your operating model, then shape the role around your requirements."/>
  <section class="section wrap compact-top"><h2>Explore your industry.</h2><DiscoveryList items={industries} base="industries"/></section>
  <section class="section experience-band"><div class="wrap detail-grid"><h2>Practical experience.<br/>Clear possibilities.</h2><div><p>Our real operational experience includes Shopify product administration, telephone sales verification, digital platform management and after-hours surveillance monitoring.</p><p>Every industry has different requirements. We assess the skills, experience and support needed for your role, then recruit to match your business.</p><a class="text-link" href="/business-needs/">Start with the business need instead →</a></div></div></section><CTASection/>
</Layout>
