---
import ChatForm from './ChatForm.astro';
interface Props { initialMode?: 'chat' | 'quote'; }
const {initialMode='quote'}=Astro.props;
import { business, equipmentOptions, startTimeframes, talentPreferences } from '../data/business';
---
<section id="enquiry" class="section form-section">
  <div class="wrap enquiry-options" hidden aria-label="Choose an enquiry option">
    <button type="button" data-enquiry-choice="chat" aria-controls="chat-panel" aria-pressed={initialMode==='chat'}><strong>Let’s have a chat</strong><span>A quick question or an initial conversation.</span></button>
    <button type="button" data-enquiry-choice="quote" aria-controls="quote-panel" aria-pressed={initialMode==='quote'}><strong>Get a staffing quote</strong><span>Share your role, skills and setup requirements.</span></button>
  </div>
  <div id="chat-panel" hidden={initialMode!=='chat'}><ChatForm/></div>
  <div id="quote-panel" hidden={initialMode!=='quote'}>
  <div class="wrap form-layout">
    <div><h2>Get an indicative quote.</h2><p>Start with your staffing brief. Four manageable steps to describe the person you need.</p><aside class="notice" id="enquiry-behaviour"><strong>Send your requirements to our team.</strong><p>Your enquiry is emailed to iHire Global so we can discuss your staffing needs. Sending it does not commit you to a quote or service.</p></aside></div>
    <form id="talent-form" aria-describedby="enquiry-behaviour enquiry-privacy" data-mode={business.enquiry.mode} data-endpoint={business.enquiry.endpoint}>
      <ol class="form-progress" aria-label="Staffing brief progress" hidden>{['About you','Your role','Skills & setup','Review'].map((name,index) => <li><span aria-hidden="true">{index+1}</span>{name}</li>)}</ol>
      <p id="step-status" class="field-help" role="status" aria-live="polite"></p>
      <section class="form-step" aria-labelledby="step-1-title"><h3 id="step-1-title" tabindex="-1">About you</h3><fieldset><legend class="sr-only">Contact information</legend><div class="form-grid"><label for="contact-name">Name <span>(required)</span><input id="contact-name" name="contact_name" autocomplete="name" required maxlength="120"/></label><label for="company-name">Company <span>(required)</span><input id="company-name" name="company_name" autocomplete="organization" required maxlength="160"/></label><label for="work-email">Work email <span>(required)</span><input id="work-email" name="work_email" type="email" autocomplete="email" required maxlength="200"/></label><label for="phone">Phone <span>(optional)</span><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40"/></label><label class="full" for="country">Country <span>(required)</span><select id="country" name="country" required><option value="">Select your country</option><option value="NZ">New Zealand</option><option value="AU">Australia</option><option value="OTHER">Other</option></select></label></div></fieldset></section>
      <section class="form-step" aria-labelledby="step-2-title"><h3 id="step-2-title" tabindex="-1">What do you need?</h3><fieldset><legend class="sr-only">Staffing requirement</legend><div class="form-grid"><label class="full" for="role-title">Role / job title <span>(required)</span><input id="role-title" name="role_title" required maxlength="160" placeholder="e.g. Customer service coordinator"/></label><label for="headcount">Number of people required <span>(required)</span><input id="headcount" name="headcount" type="number" min="1" max="1000" step="1" value="1" required/></label><label class="full" for="responsibilities">Main responsibilities <span>(required)</span><textarea id="responsibilities" name="responsibilities" rows="4" required maxlength="5000" placeholder="What will this person do in a typical week?"></textarea></label><label for="start-timeframe">Desired start timeframe<select id="start-timeframe" name="start_timeframe">{startTimeframes.map(([value,label]) => <option value={value}>{label}</option>)}</select></label></div><label for="preferred-location">Preferred talent location<select id="preferred-location" name="preferred_location" aria-describedby="location-help">{talentPreferences.map(([value,label]) => <option value={value} selected={value==='recommendation'}>{label}</option>)}</select></label><p class="field-help" id="location-help">Sri Lanka is our established primary operation. Other countries are additional sourcing options. Availability and support depend on the role and must be confirmed.</p></fieldset></section>
      <section class="form-step" aria-labelledby="step-3-title"><h3 id="step-3-title" tabindex="-1">Skills and setup</h3><fieldset><legend class="sr-only">Skills and working arrangements</legend><div class="form-grid"><label class="full" for="required-skills">Required skills <span>(required)</span><textarea id="required-skills" name="required_skills" rows="3" required maxlength="3000" placeholder="Tools, systems, communication or technical skills…"></textarea></label><label class="full" for="required-experience">Required experience <span>(optional)</span><textarea id="required-experience" name="required_experience" rows="3" maxlength="3000" placeholder="Relevant work, seniority or qualifications. Tell us if you need a recommendation."></textarea></label><label class="full" for="working-hours">Preferred working hours <span>(optional)</span><input id="working-hours" name="working_hours" maxlength="300" aria-describedby="hours-help" placeholder="e.g. Monday–Friday, 9am–5pm Auckland time"/><span class="field-help" id="hours-help">Include the days and your time zone, or say if the hours are still to be decided.</span></label></div></fieldset><fieldset class="equipment-fields" aria-describedby="equipment-help"><legend>Equipment / infrastructure</legend><p class="field-help" id="equipment-help">Select any requirements you know about. We’ll confirm inclusions and any separate costs in your quote. You can select “Unsure” alongside items you already know you need.</p><div class="equipment-options">{equipmentOptions.map(([value,label]) => <label class="checkbox-option" for={`equipment-${value}`}><input type="checkbox" id={`equipment-${value}`} name="equipment_requirements" value={value}/><span>{label}</span></label>)}</div></fieldset><label for="connectivity-details">Connectivity requirements <span>(optional)</span><textarea id="connectivity-details" name="connectivity_requirements" rows="2" maxlength="2000" placeholder="Internet access, backup connection or guidance needed"></textarea></label><label for="notes">Additional information <span>(optional)</span><textarea id="notes" name="notes" rows="4" maxlength="5000" placeholder="Specialist hardware, connectivity, team setup or other requirements…"></textarea></label></section>
      <section class="form-step" aria-labelledby="step-4-title" hidden><h3 id="step-4-title" tabindex="-1">Review your staffing brief</h3><p>Check the details below. Use Back to make changes before sending your enquiry.</p><div id="brief-review"></div></section>
      <div class="form-actions"><button class="button secondary" type="button" id="brief-back" hidden>Back</button><button class="button" type="button" id="brief-next" hidden>Next <span aria-hidden="true">&rarr;</span></button><button class="button" type="submit" disabled id="send-enquiry">Send Enquiry <span aria-hidden="true">&rarr;</span></button></div>
      <div class="enquiry-trap" aria-hidden="true"><label>Leave this blank<input name="website" tabindex="-1" autocomplete="off"/></label></div><p class="fine-print" id="enquiry-privacy">iHire Global uses these details to respond to your enquiry and scope your staffing needs. Read our <a href="/privacy/" target="_blank" rel="noopener">privacy policy (opens in a new tab)</a> for how we handle your information and your choices. Please do not include sensitive personal information. You can also email <a href="mailto:enquiries@ihireglobal.com">enquiries@ihireglobal.com</a>.</p>
      <p id="form-status" role="status" aria-live="polite"></p>
      <p id="brief-script-note">Enable JavaScript to send this form, or email enquiries@ihireglobal.com.</p>
    </form>
  </div>
  </div>
</section>
<script>
  import { createEnquiryDraft, enquiryBriefRows } from '../lib/enquiry';
  const options=document.querySelector<HTMLElement>('.enquiry-options');
  if(options){
    options.hidden=false;
    options.querySelectorAll<HTMLButtonElement>('[data-enquiry-choice]').forEach(button=>button.addEventListener('click',()=>{
      const mode=button.dataset.enquiryChoice;
      options.querySelectorAll<HTMLButtonElement>('[data-enquiry-choice]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
      document.querySelector<HTMLElement>('#chat-panel')!.hidden=mode!=='chat';
      document.querySelector<HTMLElement>('#quote-panel')!.hidden=mode!=='quote';
    }));
  }
  const form = document.querySelector<HTMLFormElement>('#talent-form');
  if (form) {
    const steps = Array.from(form.querySelectorAll<HTMLElement>('.form-step'));
    const next = form.querySelector<HTMLButtonElement>('#brief-next')!;
    const back = form.querySelector<HTMLButtonElement>('#brief-back')!;
    const send = form.querySelector<HTMLButtonElement>('#send-enquiry')!;
    const endpoint = form.dataset.endpoint!;
    let token = '';
    let busy = false;
    let sent = false;
    const loadToken = async () => {
      const response = await fetch(endpoint, {headers: {'Accept':'application/json'}, cache:'no-store', signal:AbortSignal.timeout(15000)});
      if (!response.ok) throw new Error('The enquiry service is unavailable. Please try again or email enquiries@ihireglobal.com.');
      const result = await response.json();
      if (typeof result.token !== 'string') throw new Error('The enquiry service is unavailable. Please email enquiries@ihireglobal.com.');
      token = result.token;
    };
    const progress = form.querySelector<HTMLOListElement>('.form-progress')!;
    const stepStatus = form.querySelector<HTMLElement>('#step-status')!;
    const status = form.querySelector<HTMLElement>('#form-status')!;
    const review = form.querySelector<HTMLElement>('#brief-review')!;
    let current = 0;
    form.noValidate = true;
    send.disabled = false;
    progress.hidden = false;
    form.querySelector<HTMLElement>('#brief-script-note')!.hidden = true;
    const fields = (step: HTMLElement) => Array.from(step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input,textarea,select'));
    const validate = (index: number) => {
      const controls = fields(steps[index]);
      controls.forEach(field => {
        field.setCustomValidity(field.required && field.value.length > 0 && !field.value.trim() ? 'Please enter a value, not just spaces.' : '');
        field.removeAttribute('aria-invalid');
      });
      const invalid = controls.find(field => !field.checkValidity());
      if (invalid) { invalid.setAttribute('aria-invalid','true'); invalid.reportValidity(); return false; }
      return true;
    };
    const renderReview = () => {
      const list = document.createElement('dl');
      for (const [label, value] of enquiryBriefRows(createEnquiryDraft(new FormData(form)))) {
        const item = document.createElement('div');
        const term = document.createElement('dt'); term.textContent = label;
        const detail = document.createElement('dd'); detail.textContent = String(value || 'Not specified');
        item.append(term, detail); list.append(item);
      }
      review.replaceChildren(list);
    };
    const show = (index: number, focus = true) => {
      current = index;
      steps.forEach((step,i) => { step.hidden = i !== index; });
      Array.from(progress.children).forEach((item,i) => {
        if (i === index) item.setAttribute('aria-current','step'); else item.removeAttribute('aria-current');
        item.classList.toggle('is-complete',i < index);
      });
      back.hidden = index === 0; next.hidden = index === 3; send.hidden = index !== 3;
      status.textContent = '';
      stepStatus.textContent = 'Step '+(index+1)+' of 4: '+steps[index].querySelector('h3')!.textContent;
      if (index === 3) renderReview();
      if (focus) steps[index].querySelector<HTMLElement>('h3')!.focus();
    };
    form.addEventListener('input', event => {
      const field = event.target;
      if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
        field.setCustomValidity(field.required && field.value.length > 0 && !field.value.trim() ? 'Please enter a value, not just spaces.' : '');
        field.removeAttribute('aria-invalid');
      }
      status.textContent = '';
    });
    next.addEventListener('click', () => { if (validate(current)) show(current+1); });
    back.addEventListener('click', () => show(current-1));
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (busy || sent) return;
      if (current < 3) { if (validate(current)) show(current+1); return; }
      for (let i=0; i<3; i++) {
        if (fields(steps[i]).some(field => !field.checkValidity())) { show(i); validate(i); return; }
      }
      busy = true; send.disabled = true; back.disabled = true;
      send.textContent = 'Sending…';
      form.setAttribute('aria-busy', 'true');
      status.textContent = 'Sending your enquiry…';
      try {
        if (!token) await loadToken();
        const data = new FormData(form);
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 30000);
        let response: Response;
        try {
          response = await fetch(endpoint, {
            method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'},
            body: JSON.stringify({...Object.fromEntries(data), equipment_requirements:data.getAll('equipment_requirements'), token}),
            signal: controller.signal
          });
        } finally { clearTimeout(timer); }
        const result = await response.json();
        if (!response.ok || result.ok !== true) {
          if (response.status === 403) token = '';
          throw new Error(typeof result.message === 'string' ? result.message : 'We could not send your enquiry. Please retry or email enquiries@ihireglobal.com.');
        }
        sent = true;
        send.textContent = 'Enquiry sent';
        back.hidden = true;
        status.textContent = 'Thank you. Your enquiry has been sent to iHire Global. Reference: ' + result.reference + '. Our team will contact you to discuss your requirements.';
      } catch (error) {
        const message = error instanceof Error && error.name !== 'AbortError' && error.name !== 'SyntaxError' ? error.message : 'We could not confirm delivery. Please retry; the same enquiry will not be sent twice.';
        status.textContent = message + ' Your answers have been kept on this page.';
        send.textContent = 'Send Enquiry';
      } finally {
        busy = false; send.disabled = sent; back.disabled = false;
        form.removeAttribute('aria-busy');
        status.tabIndex = -1; status.focus();
      }
    });
    show(0,false);
  }
</script>

<style>
.enquiry-options:not([hidden]) {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-bottom:40px}
.enquiry-options button {position:relative;text-align:left;padding:24px 64px 24px 24px;border:3px solid #596461;border-radius:10px;background:#303a3d;color:var(--background);box-shadow:0 4px 12px #20282b12}
.enquiry-options button::after {content:"";position:absolute;top:24px;right:24px;width:24px;height:24px;border:2px solid #cdd1ce;border-radius:50%;display:grid;place-items:center;font-size:16px;font-weight:700;line-height:1}
.enquiry-options button:hover {background:var(--primary);border-color:#cdd1ce}
.enquiry-options button:focus-visible {outline:3px solid #846100;outline-offset:5px}
.enquiry-options strong,.enquiry-options span {display:block}
.enquiry-options strong {font-size:1.25rem;margin-bottom:8px}
.enquiry-options span {font-size:1rem;line-height:1.5}
.enquiry-options button[aria-pressed="true"] {background:var(--primary);border-color:var(--accent);box-shadow:0 4px 12px #20282b12}
.enquiry-options button[aria-pressed="true"]::after {content:"✓";background:var(--accent);border-color:var(--accent);color:var(--primary)}
@media(max-width:600px){.enquiry-options:not([hidden]){grid-template-columns:1fr;gap:12px}.enquiry-options button{padding:20px 56px 20px 20px}.enquiry-options button::after{top:20px;right:18px}}
.enquiry-trap { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }</style>
